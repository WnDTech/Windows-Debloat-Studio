<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Windows Debloat Studio"
        Width="1340" Height="880" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ================================================= tweak card template -->
        <DataTemplate x:Key="TweakTemplate">
            <Border Margin="0,0,0,8" CornerRadius="10" Background="{StaticResource Card}"
                    BorderThickness="1" BorderBrush="{StaticResource BorderSoft}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1A2131" />
                                <Setter Property="BorderBrush" Value="#FF2B3648" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Background" Value="#FF171E2D" />
                                <Setter Property="BorderBrush" Value="#FF33415A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="16,13,14,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- risk stripe -->
                    <Border Grid.Column="0" Grid.RowSpan="2" Width="3" CornerRadius="2"
                            HorizontalAlignment="Left" Margin="0,2,0,2"
                            Background="{Binding Risk, Converter={StaticResource RiskBrush}}"
                            Opacity="0.65" />

                    <!-- headline block -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="14,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                    Background="#FF161C28">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0"
                                             Fill="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                    <TextBlock Text="{Binding RiskLabel}" Style="{StaticResource ChipText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Background="#FF161C28"
                                    ToolTip="State detected on this PC right now">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                               VerticalAlignment="Center" Margin="0,0,5,0"
                                               Foreground="{Binding CurrentState, Converter={StaticResource StateBrush}}" />
                                    <TextBlock Text="{Binding CurrentState}" Style="{StaticResource ChipText}"
                                               Foreground="{Binding CurrentState, Converter={StaticResource StateBrush}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Background="#FF2A2119"
                                    BorderBrush="#FF5A4526"
                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolVis}}"
                                    ToolTip="A restart is needed before this takes full effect">
                                <TextBlock Text="Restart" Style="{StaticResource ChipText}" Foreground="#FFE0B776" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Impact}" Style="{StaticResource Body}" FontSize="12.5"
                                   Foreground="{StaticResource TextDim}" Margin="0,0,0,0" />
                    </StackPanel>

                    <!-- tri-state selector -->
                    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border CornerRadius="8" Background="#FF0E121B" BorderThickness="1"
                                BorderBrush="{StaticResource Border}" Padding="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegEnable}" Content="Enable"
                                             ToolTip="{Binding EnableMeans}"
                                             IsChecked="{Binding State, Mode=TwoWay,
                                                 Converter={StaticResource StateEq}, ConverterParameter=Enable}" />
                                <RadioButton Style="{StaticResource SegDisable}" Content="Disable"
                                             ToolTip="{Binding DisableMeans}"
                                             IsChecked="{Binding State, Mode=TwoWay,
                                                 Converter={StaticResource StateEq}, ConverterParameter=Disable}" />
                                <RadioButton Style="{StaticResource SegRevert}" Content="Revert"
                                             ToolTip="{Binding RevertMeans}"
                                             IsChecked="{Binding State, Mode=TwoWay,
                                                 Converter={StaticResource StateEq}, ConverterParameter=Revert}" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnCardClear" AutomationProperties.Name="Clear this selection" Style="{StaticResource IconBtn}" Content="&#xE894;"
                                Margin="6,0,0,0" ToolTip="Clear this selection"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}" />

                        <Button x:Name="BtnCardExpand" AutomationProperties.Name="Show the full explanation" Style="{StaticResource IconBtn}" Content="&#xE70D;"
                                Margin="2,0,0,0" ToolTip="Show the full explanation" />
                    </StackPanel>

                    <!-- expanded explanation -->
                    <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="14,13,0,0"
                            Background="#FF0E121B" CornerRadius="8" Padding="15,13"
                            BorderThickness="1" BorderBrush="{StaticResource BorderSoft}"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ExpandSlide" Y="0" />
                        </Border.RenderTransform>
                        <!-- Animates FROM transparent, never TO it: if the
                             storyboard never runs the panel is simply visible,
                             rather than stuck invisible. -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.16" />
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                        From="-6" To="0" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="WHAT THIS IS" Style="{StaticResource Overline}" Margin="0,0,0,5" />
                            <TextBlock Text="{Binding Explain}" Style="{StaticResource Body}" Margin="0,0,0,13" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="7" Padding="11,9" Background="#FF141C2A"
                                        BorderThickness="1" BorderBrush="#FF25344B">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="10" Foreground="#FF6CB8FF" VerticalAlignment="Center" />
                                            <TextBlock Text="ENABLE" Style="{StaticResource Overline}"
                                                       Foreground="#FF6CB8FF" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding EnableMeans}" Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource TextDim}" LineHeight="17" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" CornerRadius="7" Padding="11,9" Background="#FF241A14"
                                        BorderThickness="1" BorderBrush="#FF4A3423">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="10" Foreground="#FFFF9A6B" VerticalAlignment="Center" />
                                            <TextBlock Text="DISABLE" Style="{StaticResource Overline}"
                                                       Foreground="#FFFF9A6B" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisableMeans}" Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource TextDim}" LineHeight="17" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" CornerRadius="7" Padding="11,9" Background="#FF1D1830"
                                        BorderThickness="1" BorderBrush="#FF3A2F5C">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="10" Foreground="#FFB98CFF" VerticalAlignment="Center" />
                                            <TextBlock Text="REVERT" Style="{StaticResource Overline}"
                                                       Foreground="#FFB98CFF" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding RevertMeans}" Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource TextDim}" LineHeight="17" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Margin="0,13,0,0">
                                <TextBlock Text="TECHNICAL DETAIL" Style="{StaticResource Overline}" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding ActionSummary}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="11" Foreground="{StaticResource TextFaint}"
                                           TextWrapping="Wrap" LineHeight="17" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ================================================= preset card template -->
        <DataTemplate x:Key="PresetTemplate">
            <Border Margin="0,0,0,11" CornerRadius="11" Background="{StaticResource Card}"
                    BorderThickness="1" BorderBrush="{StaticResource BorderSoft}" Padding="19,17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11" VerticalAlignment="Top"
                            Background="#FF19212F" BorderThickness="1" BorderBrush="{StaticResource Border}">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,18,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                       FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Background="#FF161C28">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0"
                                             Fill="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                    <TextBlock Text="{Binding RiskLabel}" Style="{StaticResource ChipText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Background="#FF1B2634"
                                    BorderBrush="#FF2F4560"
                                    Visibility="{Binding IsUserPreset, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Your preset" Style="{StaticResource ChipText}"
                                           Foreground="#FF8FB6E8" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Background="#FF2A2419"
                                    BorderBrush="#FF6A5426"
                                    ToolTip="Included with Pro. Everything this preset does is also reachable free by ticking the same options yourself."
                                    Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                               VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#FFE0B776" />
                                    <TextBlock Text="Pro" Style="{StaticResource ChipText}" Foreground="#FFE0B776" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,0,0,9" />

                        <Border Background="#FF0E121B" CornerRadius="7" Padding="13,10" Margin="0,0,0,9"
                                BorderThickness="1" BorderBrush="{StaticResource BorderSoft}">
                            <StackPanel>
                                <TextBlock Text="WHAT THIS PRESET WILL DO" Style="{StaticResource Overline}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" FontSize="12.5"
                                           LineHeight="20" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FF2A1A1C" CornerRadius="7" Padding="13,9" Margin="0,0,0,9"
                                BorderThickness="1" BorderBrush="#FF5A2E33"
                                Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{StaticResource Red}" VerticalAlignment="Top"
                                           Margin="0,1,10,0" />
                                <TextBlock Text="{Binding Warning}" Style="{StaticResource Body}" FontSize="12.5"
                                           Foreground="#FFFFB3B8" MaxWidth="640" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CountSummary}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="  |  " Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Categories}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" MinWidth="150">
                        <Button x:Name="BtnPresetStage" AutomationProperties.Name="{Binding StageLabel}" Style="{StaticResource BtnPrimary}"
                                Padding="14,8" FontSize="12.5"
                                ToolTip="Load this preset's choices into the option list. Nothing is applied until you press Apply changes.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FB;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding StageLabel}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnPresetInspect" AutomationProperties.Name="Review this preset item by item" Style="{StaticResource BtnGhost}" Margin="0,7,0,0"
                                Padding="14,8" FontSize="12.5" Content="Review item by item"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolVis}}"
                                ToolTip="Stage the preset and jump to the first affected category" />
                        <Button x:Name="BtnPresetExport" AutomationProperties.Name="Export this preset to a file" Style="{StaticResource BtnQuiet}" Margin="0,4,0,0"
                                Content="Export to file&#8230;" />
                        <Button x:Name="BtnPresetDelete" AutomationProperties.Name="Delete this preset" Style="{StaticResource BtnQuiet}" Margin="0,1,0,0"
                                Foreground="{StaticResource Red}" Content="Delete preset"
                                Visibility="{Binding IsUserPreset, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ================================================= rail item template -->
        <DataTemplate x:Key="RailTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                           FontSize="15" Width="22" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="9,0,6,0"
                           VerticalAlignment="Center" Foreground="{StaticResource Text}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CoverageText}" />
                <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="7,1.5"
                        Background="#FF1D3557" BorderBrush="#FF3C6FB8"
                        Visibility="{Binding HasPending, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding Pending}" Style="{StaticResource ChipText}" Foreground="#FFB9D4FF" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="7,1.5"
                        Background="Transparent" BorderBrush="Transparent"
                        Visibility="{Binding HasPending, Converter={StaticResource BoolVis},
                            ConverterParameter=invert}">
                    <TextBlock Text="{Binding Total}" Style="{StaticResource ChipText}"
                               Foreground="{StaticResource TextFaint}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ================================================= top rail template -->
        <DataTemplate x:Key="RailTopTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                           FontSize="15" Width="22" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="9,0,6,0"
                           VerticalAlignment="Center" Foreground="{StaticResource Text}" />
            </Grid>
        </DataTemplate>

        <!-- ================================================= change row template -->
        <DataTemplate x:Key="ChangeTemplate">
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="5" Padding="0,3" Margin="0,0,11,0"
                        Background="#FF141B27" BorderThickness="1"
                        BorderBrush="{Binding Action, Converter={StaticResource ActionBrush}}">
                    <TextBlock Text="{Binding Action}" Style="{StaticResource ChipText}"
                               HorizontalAlignment="Center"
                               Foreground="{Binding Action, Converter={StaticResource ActionBrush}}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Text}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Category}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="11,0,0,0" />
            </Grid>
        </DataTemplate>

        <!-- ================================================= log row template -->
        <DataTemplate x:Key="LogTemplate">
            <Grid Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="{StaticResource MonoFont}"
                           FontSize="10.5" Foreground="#FF4E5666" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{Binding Level, Converter={StaticResource LogBrush}}" />
            </Grid>
        </DataTemplate>

        <!-- plain, non-highlighting list container -->
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ==================================================================== shell -->
    <Border BorderThickness="1" BorderBrush="#FF232B3A" Background="{StaticResource Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ====================================================== title bar -->
            <Grid Grid.Row="0" Background="#FF0C1017">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <!--
                        The app mark, drawn rather than set as a glyph so it is
                        the same shape as assets\app.ico and the website's logo:
                        a solid square with a corner bracket open to the top
                        right. Deliberately one fixed blue in all three places -
                        a logo that changes colour with the theme stops reading
                        as the same logo.
                    -->
                    <Border Width="22" Height="22" CornerRadius="6" Background="#FF4C8DFF">
                        <Border Width="10" Height="10" BorderThickness="1.8,0,0,1.8" BorderBrush="White"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,1,0" />
                    </Border>
                    <TextBlock Text="Windows Debloat Studio" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="Windows 11" FontSize="11" Foreground="{StaticResource TextFaint}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Style="{StaticResource Chip}" Background="#FF14202D" BorderBrush="#FF27405A">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="#FF6CB8FF" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding AdminText}" Style="{StaticResource ChipText}"
                                       Foreground="#FF9CC8FF" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnTier" AutomationProperties.Name="Licence and tier"
                            Style="{StaticResource TierChip}" Margin="10,0,0,0"
                            ToolTip="Your licence tier. Click for details.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding TierName}" Style="{StaticResource ChipText}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRescan" AutomationProperties.Name="Re-read the live state of every option" Style="{StaticResource IconBtn}" Content="&#xE72C;" Margin="8,0,0,0"
                            ToolTip="Re-read the live state of every option from this PC" />
                    <Button x:Name="BtnHelp" AutomationProperties.Name="How this app works" Style="{StaticResource IconBtn}" Content="&#xE897;" Margin="2,0,0,0"
                            ToolTip="How this app works" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMin" AutomationProperties.Name="Minimise" Style="{StaticResource CaptionBtn}" Content="&#xE921;" />
                    <Button x:Name="BtnMax" AutomationProperties.Name="Maximise or restore" Style="{StaticResource CaptionBtn}" Content="&#xE922;" />
                    <Button x:Name="BtnClose" AutomationProperties.Name="Close" Style="{StaticResource CaptionBtnClose}" Content="&#xE8BB;" />
                </StackPanel>
            </Grid>

            <!-- ====================================================== body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============================ left rail -->
                <Border Grid.Column="0" Background="{StaticResource RailGrad}" BorderThickness="0,0,1,0"
                        BorderBrush="{StaticResource Border}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- search -->
                        <Border Grid.Row="0" Margin="14,14,14,10" CornerRadius="8" Background="#FF0D1119"
                                BorderThickness="1" BorderBrush="{StaticResource Border}" Padding="11,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Foreground="{StaticResource TextFaint}"
                                           VerticalAlignment="Center" Margin="0,0,9,0" />
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="SearchHint" Text="Search every option&#8230;" FontSize="12.5"
                                               Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Text, ElementName=TxtSearch,
                                                   Converter={StaticResource StrVis}, ConverterParameter=invert}" />
                                    <TextBox x:Name="TxtSearch" AutomationProperties.Name="Search every option" Style="{StaticResource SearchBox}" />
                                </Grid>
                                <Button x:Name="BtnSearchClear" AutomationProperties.Name="Clear the search box" Grid.Column="2" Style="{StaticResource IconBtn}"
                                        Width="20" Height="20" FontSize="10" Content="&#xE894;"
                                        Visibility="{Binding Text, ElementName=TxtSearch,
                                            Converter={StaticResource StrVis}}" />
                            </Grid>
                        </Border>

                        <!-- top-level nav -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,4">
                            <ListBox x:Name="RailTop" AutomationProperties.Name="Main sections" Style="{StaticResource RailList}"
                                     ItemTemplate="{StaticResource RailTopTemplate}" />
                            <Border Height="1" Background="{StaticResource Border}" Margin="20,10,20,8" />
                            <TextBlock Text="CATEGORIES" Style="{StaticResource Overline}" Margin="22,0,0,7" />
                        </StackPanel>

                        <!-- categories -->
                        <ScrollViewer Grid.Row="2" Style="{StaticResource CleanScroll}">
                            <ListBox x:Name="RailCats" AutomationProperties.Name="Option categories" Style="{StaticResource RailList}"
                                     ItemTemplate="{StaticResource RailTemplate}" Margin="0,0,0,10" />
                        </ScrollViewer>

                        <!-- safety block -->
                        <Border Grid.Row="3" Margin="14,8,14,14" CornerRadius="10" Background="#FF121826"
                                BorderThickness="1" BorderBrush="{StaticResource Border}" Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{StaticResource Green}" VerticalAlignment="Center" />
                                    <TextBlock Text="SAFETY NET" Style="{StaticResource Overline}" Margin="8,0,0,0"
                                               Foreground="{StaticResource Green}" />
                                </StackPanel>
                                <TextBlock x:Name="TxtJournal" Style="{StaticResource Caption}" Margin="0,0,0,9"
                                           Text="Every change is journalled so it can be put back." />
                                <Button x:Name="BtnRestorePoint" AutomationProperties.Name="Create a System Restore point" Style="{StaticResource BtnGhost}" FontSize="12"
                                        Padding="11,7" HorizontalContentAlignment="Left"
                                        ToolTip="Ask Windows to create a System Restore point right now">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Create restore point" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnOpenLogs" AutomationProperties.Name="Open the log folder" Style="{StaticResource BtnQuiet}" Margin="0,3,0,0"
                                        HorizontalContentAlignment="Left" Content="Open log folder" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============================ content -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- section header -->
                    <Border Grid.Row="0" Background="{StaticResource HeroGrad}" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource Border}" Padding="30,20,30,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource H1}" />
                                <TextBlock Text="{Binding SectionBlurb}" Style="{StaticResource Body}"
                                           Margin="0,7,30,0" MaxWidth="820" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Border Background="#FF2A2119" CornerRadius="8" Padding="13,9"
                                        BorderThickness="1" BorderBrush="#FF5A4526"
                                        Visibility="{Binding RestartPending, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="12" Foreground="#FFE0B776" VerticalAlignment="Center" />
                                        <TextBlock Text="Restart needed to finish" FontSize="12"
                                                   Foreground="#FFE0B776" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- toolbar (options view only) -->
                    <Border x:Name="Toolbar" Grid.Row="1" Padding="30,12,30,12" Background="#FF0C1017"
                            BorderThickness="0,0,0,1" BorderBrush="{StaticResource Border}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="RISK" Style="{StaticResource Overline}" VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <ToggleButton x:Name="TglSafe" Style="{StaticResource FilterToggle}"
                                              IsChecked="True" Margin="0,0,6,0" Content="Safe"
                                              ToolTip="Reversible, no functional loss for most people" />
                                <ToggleButton x:Name="TglModerate" Style="{StaticResource FilterToggle}"
                                              IsChecked="True" Margin="0,0,6,0" Content="Moderate"
                                              ToolTip="Removes or changes a real feature you may use" />
                                <ToggleButton x:Name="TglAggressive" Style="{StaticResource FilterToggle}"
                                              IsChecked="True" Margin="0,0,16,0" Content="Aggressive"
                                              ToolTip="Can break updates, security or app installs. Read carefully." />
                                <CheckBox x:Name="ChkHideDone" Style="{StaticResource Check}"
                                          Content="Hide options already in the target state"
                                          VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock x:Name="TxtVisible" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock Text="SET ALL SHOWN" Style="{StaticResource Overline}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Border CornerRadius="8" Background="#FF0E121B" BorderThickness="1"
                                        BorderBrush="{StaticResource Border}" Padding="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnBulkEnable" AutomationProperties.Name="Set every shown option to Enable" Style="{StaticResource BtnQuiet}"
                                                Content="Enable" Foreground="#FF9CC8FF" />
                                        <Button x:Name="BtnBulkDisable" AutomationProperties.Name="Set every shown option to Disable" Style="{StaticResource BtnQuiet}"
                                                Content="Disable" Foreground="#FFFFC2A3" />
                                        <Button x:Name="BtnBulkRevert" AutomationProperties.Name="Set every shown option to Revert" Style="{StaticResource BtnQuiet}"
                                                Content="Revert" Foreground="#FFD9C6FF" />
                                        <Button x:Name="BtnBulkClear" AutomationProperties.Name="Clear the selection on every shown option" Style="{StaticResource BtnQuiet}"
                                                Content="Clear" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ============================ views -->
                    <Grid Grid.Row="2">

                        <!-- options list -->
                        <ListBox x:Name="LstTweaks" AutomationProperties.Name="Options in this category" Background="Transparent" BorderThickness="0"
                                 Padding="30,18,24,24" ItemTemplate="{StaticResource TweakTemplate}"
                                 ItemContainerStyle="{StaticResource PlainItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 SelectionMode="Single" Focusable="False" />

                        <!-- empty state -->
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed" MaxWidth="420">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                       Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" />
                            <TextBlock Text="Nothing matches those filters" Style="{StaticResource H2}"
                                       Margin="0,14,0,6" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Body}" TextAlignment="Center"
                                       Text="Try clearing the search box, or switch a risk filter back on." />
                        </StackPanel>

                        <!-- presets -->
                        <ScrollViewer x:Name="ViewPresets" Style="{StaticResource CleanScroll}"
                                      Visibility="Collapsed" Padding="30,20,24,24">
                            <StackPanel>
                                <Border CornerRadius="10" Background="#FF121826" Padding="19,16" Margin="0,0,0,16"
                                        BorderThickness="1" BorderBrush="{StaticResource Border}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <TextBlock Text="Presets stage choices &#8212; they never apply on their own"
                                                       Style="{StaticResource H2}" FontSize="15" />
                                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                                       Text="Staging a preset ticks Enable, Disable or Revert on the options it covers and leaves everything else untouched. You can then walk the categories, change your mind on any single option, and only then press Apply changes. Presets are plain JSON files, so you can share one with a colleague and they get exactly your choices." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="180">
                                            <Button x:Name="BtnPresetSaveCurrent" AutomationProperties.Name="Save the current selection as a preset" Style="{StaticResource BtnPrimary}"
                                                    Padding="14,9" FontSize="12.5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="Save current selection" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnPresetImport" AutomationProperties.Name="Import a preset file" Style="{StaticResource BtnGhost}"
                                                    Margin="0,7,0,0" Padding="14,9" FontSize="12.5"
                                                    Content="Import a preset file&#8230;" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ItemsControl x:Name="LstPresets" AutomationProperties.Name="Available presets" ItemTemplate="{StaticResource PresetTemplate}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- overview -->
                        <ScrollViewer x:Name="ViewOverview" Style="{StaticResource CleanScroll}"
                                      Visibility="Collapsed" Padding="30,20,24,24">
                            <StackPanel x:Name="OverviewHost" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ====================================================== footer -->
            <Border Grid.Row="2" Background="#FF0C1017" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource Border}" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Margin="6,0,11,0"
                                Background="{StaticResource TextFaint}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPending}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding PendingText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnClearAll" AutomationProperties.Name="Clear all selections" Style="{StaticResource BtnQuiet}" Content="Clear all selections"
                                Margin="0,0,6,0" />
                        <Button x:Name="BtnSavePreset" AutomationProperties.Name="Save the current selection as a preset" Style="{StaticResource BtnGhost}" Margin="0,0,6,0"
                                Padding="13,9" FontSize="12.5" Content="Save as preset&#8230;" />
                        <Button x:Name="BtnUndoAll" AutomationProperties.Name="Undo every change this app has made" Style="{StaticResource BtnUndo}" Margin="0,0,6,0"
                                Padding="13,9" FontSize="12.5" IsEnabled="{Binding CanUndo}"
                                ToolTip="Put every change this app has ever made on this PC back the way it was">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding UndoText}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnApply" AutomationProperties.Name="Review and apply the staged changes" Style="{StaticResource BtnPrimary}" Padding="20,9"
                                IsEnabled="{Binding HasPending}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,9,0" />
                                <TextBlock Text="Review &amp; apply" FontSize="13.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================== overlays -->

            <!-- confirm sheet -->
            <Grid x:Name="OvConfirm" Grid.RowSpan="3" Background="#CC05070B" Visibility="Collapsed">
                <Border MaxWidth="920" MaxHeight="780" Margin="34" CornerRadius="13"
                        Background="{StaticResource Surface}" BorderThickness="1"
                        BorderBrush="{StaticResource BorderStrong}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="28,24,28,0">
                            <TextBlock x:Name="TxtConfirmTitle" Text="Review the changes" Style="{StaticResource H1}"
                                       FontSize="22" />
                            <TextBlock x:Name="TxtConfirmSummary" Style="{StaticResource Body}" Margin="0,8,0,0" />
                        </StackPanel>

                        <Border x:Name="ConfirmWarn" Grid.Row="1" Margin="28,16,28,0" CornerRadius="9"
                                Background="#FF2A1A1C" BorderThickness="1" BorderBrush="#FF5A2E33"
                                Padding="15,12" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource Red}" VerticalAlignment="Top"
                                           Margin="0,1,12,0" />
                                <TextBlock x:Name="TxtConfirmWarn" Style="{StaticResource Body}" FontSize="12.5"
                                           Foreground="#FFFFB3B8" MaxWidth="700" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2" Style="{StaticResource CleanScroll}" Margin="28,18,20,0">
                            <ItemsControl x:Name="LstChanges" AutomationProperties.Name="Changes about to be applied" ItemTemplate="{StaticResource ChangeTemplate}" />
                        </ScrollViewer>

                        <Border Grid.Row="3" Background="#FF0C1017" CornerRadius="0,0,12,12" Padding="28,16"
                                BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Grid.Row="0">
                                        <CheckBox x:Name="ChkRestorePoint" Style="{StaticResource Check}"
                                                  Content="Create a System Restore point first" />
                                        <TextBlock x:Name="TxtRestoreNote" Style="{StaticResource Caption}"
                                                   Margin="26,4,0,0"
                                                   Text="Recommended. Needs System Protection on for the system drive." />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="0">
                                        <CheckBox x:Name="ChkRestartExplorer" Style="{StaticResource Check}"
                                                  Content="Restart File Explorer afterwards" />
                                        <TextBlock x:Name="TxtExplorerNote" Style="{StaticResource Caption}"
                                                   Margin="26,4,0,0"
                                                   Text="Needed for shell changes to appear. Closes open Explorer windows." />
                                    </StackPanel>

                                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,11,0,0">
                                        <CheckBox x:Name="ChkAllUsers" Style="{StaticResource Check}"
                                                  Content="Apply per-user options to all accounts" />
                                        <TextBlock x:Name="TxtAllUsersNote" Style="{StaticResource Caption}"
                                                   Margin="26,4,0,0" Text="Checking profiles..." />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,11,0,0">
                                        <CheckBox x:Name="ChkDryRun" Style="{StaticResource Check}"
                                                  Content="Dry run - change nothing" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="26,4,0,0"
                                                   Text="Writes the full log of what would happen and touches nothing." />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="BtnConfirmCancel" AutomationProperties.Name="Go back without applying" Style="{StaticResource BtnGhost}"
                                            Content="Go back" Margin="0,0,9,0" Height="42" />
                                    <Button x:Name="BtnConfirmApply" AutomationProperties.Name="Apply the changes now" Style="{StaticResource BtnPrimary}"
                                            Padding="22,10" Content="Apply now" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- busy / progress -->
            <Grid x:Name="OvBusy" Grid.RowSpan="3" Background="#E605070B" Visibility="Collapsed">
                <Border MaxWidth="820" MaxHeight="640" Margin="40" CornerRadius="13"
                        Background="{StaticResource Surface}" BorderThickness="1"
                        BorderBrush="{StaticResource BorderStrong}">
                    <Grid Margin="28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding BusyTitle}" Style="{StaticResource H1}" FontSize="21" />
                            <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource Body}" Margin="0,7,0,0" />
                        </StackPanel>

                        <ProgressBar Grid.Row="1" x:Name="PbProgress" Style="{StaticResource Bar}"
                                     Margin="0,18,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding Progress}" />

                        <Border Grid.Row="2" Margin="0,18,0,0" CornerRadius="9" Background="#FF080B11"
                                BorderThickness="1" BorderBrush="{StaticResource Border}" Padding="14,11">
                            <ScrollViewer x:Name="LogScroll" Style="{StaticResource CleanScroll}">
                                <ItemsControl x:Name="LstLog" AutomationProperties.Name="Activity log" ItemTemplate="{StaticResource LogTemplate}" />
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtBusyFoot" Grid.Column="0" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnBusyCancel" AutomationProperties.Name="Stop after the current option" Style="{StaticResource BtnDanger}" Padding="15,10"
                                        Margin="0,0,9,0" Visibility="Collapsed"
                                        ToolTip="Stop after the option that is running now. Everything already done stays undoable.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Stop" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnBusySaveLog" AutomationProperties.Name="Save this log to a file" Style="{StaticResource BtnQuiet}"
                                        Content="Save this log" Margin="0,0,9,0" Visibility="Collapsed" />
                                <Button x:Name="BtnRestartNow" AutomationProperties.Name="Restart Windows now" Style="{StaticResource BtnUndo}" Padding="15,10"
                                        Margin="0,0,9,0" Visibility="Collapsed"
                                        ToolTip="Restart Windows so the pending changes take full effect">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Restart Windows now" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnBusyClose" AutomationProperties.Name="Close this panel" Style="{StaticResource BtnPrimary}" Padding="22,10"
                                        Content="Done" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- save preset -->
            <Grid x:Name="OvSave" Grid.RowSpan="3" Background="#CC05070B" Visibility="Collapsed">
                <Border MaxWidth="620" VerticalAlignment="Center" Margin="40" CornerRadius="13"
                        Background="{StaticResource Surface}" BorderThickness="1"
                        BorderBrush="{StaticResource BorderStrong}" Padding="28,24">
                    <StackPanel>
                        <TextBlock Text="Save these selections as a preset" Style="{StaticResource H1}"
                                   FontSize="21" />
                        <TextBlock x:Name="TxtSaveSummary" Style="{StaticResource Body}" Margin="0,8,0,20" />

                        <TextBlock Text="PRESET NAME" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtPresetName" AutomationProperties.Name="Preset name" Style="{StaticResource InputBox}" Margin="0,0,0,16" />

                        <TextBlock Text="ONE-LINE SUMMARY" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtPresetSummary" AutomationProperties.Name="One line summary" Style="{StaticResource InputBox}" Margin="0,0,0,16" />

                        <TextBlock Text="WHAT IT DOES &#8212; SHOWN ON THE PRESET CARD" Style="{StaticResource Overline}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="TxtPresetDetail" AutomationProperties.Name="What this preset does" Style="{StaticResource InputBox}" Height="86"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />

                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="Saved to the presets folder next to the app as a shareable .json file. Leave the description blank and one is generated from your choices." />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button x:Name="BtnSaveCancel" AutomationProperties.Name="Cancel saving the preset" Style="{StaticResource BtnGhost}" Content="Cancel"
                                    Margin="0,0,9,0" />
                            <Button x:Name="BtnSaveOk" AutomationProperties.Name="Save the preset" Style="{StaticResource BtnPrimary}" Padding="22,10"
                                    Content="Save preset" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- help -->
            <Grid x:Name="OvHelp" Grid.RowSpan="3" Background="#CC05070B" Visibility="Collapsed">
                <Border MaxWidth="760" MaxHeight="720" Margin="40" CornerRadius="13"
                        Background="{StaticResource Surface}" BorderThickness="1"
                        BorderBrush="{StaticResource BorderStrong}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" Style="{StaticResource CleanScroll}" Padding="28,24,20,0">
                            <StackPanel x:Name="HelpHost" />
                        </ScrollViewer>
                        <Button x:Name="BtnHelpClose" AutomationProperties.Name="Close help" Grid.Row="1" Style="{StaticResource BtnPrimary}"
                                Padding="22,10" Content="Got it" HorizontalAlignment="Right"
                                Margin="28,18,28,24" />
                    </Grid>
                </Border>
            </Grid>

            <!-- licence -->
            <Grid x:Name="OvLicense" Grid.RowSpan="3" Background="#CC05070B" Visibility="Collapsed">
                <Border MaxWidth="660" MaxHeight="820" VerticalAlignment="Center" Margin="40"
                        CornerRadius="13" Background="{StaticResource Surface}" BorderThickness="1"
                        BorderBrush="{StaticResource BorderStrong}">
                    <ScrollViewer Style="{StaticResource CleanScroll}" Padding="28,24,20,0">
                        <StackPanel Margin="0,0,8,24">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Licence" Style="{StaticResource H1}" FontSize="21" />
                                <Border Style="{StaticResource Chip}" Margin="12,4,0,0" Background="#FF14202D"
                                        BorderBrush="#FF27405A" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TierName}" Style="{StaticResource ChipText}"
                                               Foreground="#FF9CC8FF" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtLicDetail" Style="{StaticResource Body}" Margin="0,6,0,0" />

                            <Border Background="#FF0E121B" CornerRadius="9" Padding="15,13" Margin="0,18,0,0"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderSoft}">
                                <StackPanel>
                                    <TextBlock Text="FREE FOREVER, ON EVERY INSTALL" Style="{StaticResource Overline}"
                                               Margin="0,0,0,7" Foreground="{StaticResource Green}" />
                                    <TextBlock Style="{StaticResource Body}" FontSize="12.5"
                                               Text="All 355 options in all 15 categories. The journal, Revert, Undo everything, dry run and restore points. Nothing that protects you is ever behind a paywall, and neither is any option - including the Aggressive ones." />
                                </StackPanel>
                            </Border>

                            <Border Background="#FF141B2A" CornerRadius="9" Padding="15,13" Margin="0,10,0,0"
                                    BorderThickness="1" BorderBrush="#FF25344B">
                                <StackPanel>
                                    <TextBlock Text="WHAT PRO ADDS" Style="{StaticResource Overline}"
                                               Margin="0,0,0,7" Foreground="#FF6CB8FF" />
                                    <TextBlock x:Name="TxtLicFeatures" Style="{StaticResource Body}" FontSize="12.5" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="LicKeyBlock" Margin="0,18,0,0">
                                <TextBlock Text="LICENCE KEY" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtLicKey" AutomationProperties.Name="Licence key"
                                         Style="{StaticResource InputBox}" FontFamily="{StaticResource MonoFont}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,7,0,0"
                                           Text="From your purchase email, or your Polar purchases page. Activating sends only the key and a short machine label; nothing else about your PC leaves it, and a free install never contacts anything at all." />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="BtnLicActivate" AutomationProperties.Name="Activate this licence key"
                                            Style="{StaticResource BtnPrimary}" Padding="18,9" Content="Activate" />
                                    <Button x:Name="BtnLicBuy" AutomationProperties.Name="Buy Pro"
                                            Style="{StaticResource BtnGhost}" Padding="14,9" Margin="9,0,0,0"
                                            Content="Buy Pro&#8230;" />
                                    <Button x:Name="BtnLicBuyTech" AutomationProperties.Name="Buy Technician"
                                            Style="{StaticResource BtnQuiet}" Margin="6,0,0,0"
                                            Content="Technician&#8230;" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="LicActiveBlock" Margin="0,18,0,0" Visibility="Collapsed">
                                <TextBlock Text="THIS PC" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtLicMachine" Style="{StaticResource Body}" FontSize="12.5"
                                           FontFamily="{StaticResource MonoFont}" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="BtnLicRecheck" AutomationProperties.Name="Check the licence with Polar now"
                                            Style="{StaticResource BtnGhost}" Padding="14,9" Content="Check now" />
                                    <Button x:Name="BtnLicRemove" AutomationProperties.Name="Remove this licence from this PC"
                                            Style="{StaticResource BtnQuiet}" Margin="8,0,0,0"
                                            Foreground="{StaticResource Red}" Content="Remove from this PC" />
                                    <Button x:Name="BtnLicPortal" AutomationProperties.Name="Open your purchases page"
                                            Style="{StaticResource BtnQuiet}" Margin="4,0,0,0"
                                            Content="My purchases&#8230;" />
                                </StackPanel>
                            </StackPanel>

                            <Border Background="#FF181722" CornerRadius="9" Padding="15,12" Margin="0,18,0,0"
                                    BorderThickness="1" BorderBrush="#FF2C2A3D">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" LineHeight="18"
                                               Text="Being straight with you: this app is free software, and the licence check can be edited out by anyone who wants to. It is here as a way to pay for the work, not as copy protection. If money is the obstacle rather than the principle, use the free version with a clear conscience - it is not crippled." />
                                    <TextBlock Style="{StaticResource Caption}" LineHeight="18" Margin="0,10,0,0"
                                               Text="Windows Debloat Studio is free software under the GNU General Public License v3, and comes with absolutely no warranty. You may redistribute it under the terms of that licence. The complete source is public - which is also how you can check what it does to your PC before letting it." />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="BtnLicSource" AutomationProperties.Name="View the source code"
                                                Style="{StaticResource BtnQuiet}" Content="View the source&#8230;" />
                                        <Button x:Name="BtnLicTerms" AutomationProperties.Name="Read the GPL version 3 licence"
                                                Style="{StaticResource BtnQuiet}" Margin="4,0,0,0" Content="Licence terms&#8230;" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnLicClose" AutomationProperties.Name="Close licence panel"
                                    Style="{StaticResource BtnGhost}" Padding="20,9" Content="Close"
                                    HorizontalAlignment="Right" Margin="0,20,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- toast -->
            <Border x:Name="Toast" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,24,74" CornerRadius="9" Background="#FF1A2130" BorderThickness="1"
                    BorderBrush="{StaticResource BorderStrong}" Padding="17,11" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                               FontSize="13" Foreground="{StaticResource Green}" VerticalAlignment="Center"
                               Margin="0,0,11,0" />
                    <TextBlock x:Name="ToastText" FontSize="13" Foreground="{StaticResource Text}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
